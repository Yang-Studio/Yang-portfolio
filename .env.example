# Existing optional AI feature
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Neon Postgres, injected automatically when the Vercel Neon integration is connected
DATABASE_URL=

# Generate these values with: npm run admin:credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ANALYTICS_SALT=

# Optional: if omitted, Terra Dotta page lock reuses ADMIN_PASSWORD
TERRADOTTA_PASSWORD=
TERRADOTTA_LOCK_SECRET=
