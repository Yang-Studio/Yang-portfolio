# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.py[cod]

# next.js
/.next/
/out/

# production
/build

# local source masters
/project-sources/photography/film-archive/originals/

# local packaged app builds
/project-sources/apps/lote/

# misc
.DS_Store
*.pem
/.codex-screenshots/
/.codex-*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/.analytics.local.json
/.content-overrides.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
